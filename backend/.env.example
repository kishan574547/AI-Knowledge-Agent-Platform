# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Connection (PostgreSQL with pgvector)
# Example: postgresql+psycopg2://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg2://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres

# Supabase Auth & Storage Config
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-if-verifying-locally

# Storage Bucket
SUPABASE_STORAGE_BUCKET=documents

# Google Gemini LLM (External Generation API)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Local Embeddings (Free, Local)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Chunking Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# RAG Retrieval Configuration
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.25
MAX_CONTEXT_CHARS=12000
MAX_QUESTION_LENGTH=2000
MAX_RAG_DOCUMENT_IDS=20

# File Upload Limits
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=application/pdf,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/markdown
ALLOWED_EXTENSIONS=.pdf,.txt,.docx,.md
